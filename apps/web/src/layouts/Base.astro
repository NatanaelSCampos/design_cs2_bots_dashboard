---
import { Image } from "astro:assets";
import "../styles/global.css";
import logo from "../assets/logo.webp";
import iconeInicio from "../assets/nav-inicio.webp";
import iconeHall from "../assets/nav-hall.webp";
import iconeEstatisticas from "../assets/nav-estatisticas.webp";
import iconeRankings from "../assets/nav-rankings.webp";

interface Props {
  titulo: string;
  subtitulo?: string;
  /** Páginas com hero próprio escondem o cabeçalho de texto padrão. */
  semCabecalho?: boolean;
}

const { titulo, subtitulo, semCabecalho = false } = Astro.props;
const rota = Astro.url.pathname;

/**
 * `em_breve` marca item sem página ainda: fica visível e desabilitado, em vez
 * de levar a um 404 ou sumir da identidade que o desenho pede.
 */
const navegacao = [
  { href: "/", rotulo: "Início", icone: iconeInicio },
  { href: "/hall", rotulo: "Hall", icone: iconeHall },
  { href: "/jornal", rotulo: "Estatísticas", icone: iconeEstatisticas },
  { href: "/rankings", rotulo: "Rankings", icone: iconeRankings, em_breve: true },
];

function ativo(href: string): boolean {
  return href === "/" ? rota === "/" : rota.startsWith(href);
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · HALL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="min-h-screen">
    <header class="border-b border-line bg-sunk/60">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 gap-y-4 px-6 py-3">
        <a href="/" class="shrink-0">
          <Image src={logo} alt="HALL · CS2 Edition" width={210} height={70} loading="eager" />
        </a>

        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            navegacao.map((item) =>
              item.em_breve ? (
                <span
                  class="flex cursor-not-allowed items-center gap-2 border-b-2 border-transparent pb-1 font-mono text-xs tracking-[0.1em] text-ink-faint/50 uppercase"
                  title="Ainda não existe esta página."
                >
                  <Image src={item.icone} alt="" width={20} height={20} class="opacity-40" />
                  {item.rotulo}
                </span>
              ) : (
                <a
                  href={item.href}
                  aria-current={ativo(item.href) ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-2 border-b-2 pb-1 font-mono text-xs tracking-[0.1em] uppercase transition-colors",
                    ativo(item.href)
                      ? "border-accent text-accent"
                      : "border-transparent text-ink-soft hover:text-ink",
                  ]}
                >
                  <Image src={item.icone} alt="" width={20} height={20} />
                  {item.rotulo}
                </a>
              ),
            )
          }
        </nav>

        <div class="ml-auto flex items-center gap-3">
          {/*
            Busca e Conectar são PLACEHOLDERS: fazem parte da identidade, mas
            nenhuma das duas funciona ainda. Ficam desabilitadas com o motivo no
            title, em vez de aceitarem clique e não fazerem nada.
          */}
          <button
            type="button"
            disabled
            title="Busca ainda não implementada."
            class="hidden items-center gap-2 rounded-md border border-line bg-surface px-3 py-2 text-sm text-ink-faint/70 md:flex"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="m16 16 4 4"></path>
              </g>
            </svg>
            <span>Buscar jogadas vergonhosas…</span>
            <kbd class="rounded border border-line px-1.5 py-0.5 font-mono text-[0.6rem]">
              CTRL K
            </kbd>
          </button>

          <button
            type="button"
            disabled
            title="Login com Steam ainda não implementado."
            class="flex items-center gap-2 rounded-md bg-accent px-4 py-2 font-mono text-xs font-semibold tracking-[0.08em] text-ground uppercase opacity-80"
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-10 9.6l5.4 2.2a2.8 2.8 0 0 1 1.6-.5h.2l2.4-3.5v-.1a3.8 3.8 0 1 1 3.8 3.8h-.1l-3.4 2.4v.2a2.8 2.8 0 0 1-5.6.2l-3.8-1.6A10 10 0 1 0 12 2Zm-3.3 15.2a2.2 2.2 0 0 0 2-3l-.9-.4a1.7 1.7 0 1 1-1.3 3.1l1 .4a2.2 2.2 0 0 0-.8-.1Zm6.7-5.9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"
              ></path>
            </svg>
            Conectar
          </button>
        </div>
      </div>
    </header>

    {
      semCabecalho ? (
        <slot />
      ) : (
        <main class="mx-auto max-w-7xl px-6 py-10">
          <div class="mb-8 flex flex-col gap-2">
            <h1 class="font-display text-4xl font-bold tracking-tight text-balance">{titulo}</h1>
            {subtitulo && <p class="max-w-[60ch] text-ink-soft">{subtitulo}</p>}
          </div>
          <slot />
        </main>
      )
    }

    <footer class="mx-auto max-w-7xl px-6 pb-12">
      <p class="border-t border-line pt-5 text-sm text-ink-faint">
        Site privado. Terceiros são anonimizados por partida e nenhum dado de chat é guardado. Todo
        número tem numerador e denominador em <a class="text-accent" href="/criterios">Critérios</a>.
      </p>
    </footer>
  </body>
</html>
